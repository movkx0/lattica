+//! Isolated benchmark partitioning for complete power-of-two paired trees.
+//! The controller runs disjoint sibling subtrees, joins both workers, then
+//! starts the root partition. No proof or verification rule changes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Partition {
+    Left,
+    Right,
+    Root,
+}
+
+impl Partition {
+    pub(super) fn parse(value: &str) -> Result<Self, String> {
+        match value {
+            "left" => Ok(Self::Left),
+            "right" => Ok(Self::Right),
+            "root" => Ok(Self::Root),
+            _ => Err("aggregation partition must be left, right, or root".into()),
+        }
+    }
+
+    pub(super) fn name(self) -> &'static str {
+        match self {
+            Self::Left => "left",
+            Self::Right => "right",
+            Self::Root => "root",
+        }
+    }
+}
+
+pub(super) fn classify(level: u8, index: usize, subtree_depth: u8) -> Result<Partition, String> {
+    if !(2..=7).contains(&subtree_depth) || !(1..=7).contains(&level) {
+        return Err("aggregation partition depth outside paired 128-capacity tree".into());
+    }
+    if level >= subtree_depth {
+        if index == 0 && (level == subtree_depth || level == 7) {
+            return Ok(Partition::Root);
+        }
+        return Err("aggregation partition has an invalid root/finalizer coordinate".into());
+    }
+    match index >> (subtree_depth - level - 1) {
+        0 => Ok(Partition::Left),
+        1 => Ok(Partition::Right),
+        _ => Err("aggregation partition index outside the selected subtree".into()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_supported_complete_tree_splits_by_transaction_interval() {
+        for depth in 2..=7 {
+            let half = 1usize << (depth - 1);
+            let mut counts = [0; 3];
+            for level in 1..=depth {
+                for index in 0..1usize << (depth - level) {
+                    let partition = classify(level, index, depth).unwrap();
+                    let start = index << level;
+                    let end = (index + 1) << level;
+                    let expected = if end <= half { Partition::Left }
+                        else if start >= half { Partition::Right }
+                        else { Partition::Root };
+                    assert_eq!(partition, expected);
+                    counts[match partition { Partition::Left => 0, Partition::Right => 1, Partition::Root => 2 }] += 1;
+                }
+            }
+            assert_eq!(counts, [half - 1, half - 1, 1]);
+            if depth < 7 {
+                assert_eq!(classify(7, 0, depth), Ok(Partition::Root));
+            }
+        }
+    }
+
+    #[test]
+    fn all_dependencies_stay_within_their_worker_until_the_final_join() {
+        for depth in 2..=7 {
+            for level in 2..depth {
+                for index in 0..1usize << (depth - level) {
+                    let parent = classify(level, index, depth).unwrap();
+                    assert_eq!(classify(level - 1, index * 2, depth), Ok(parent));
+                    assert_eq!(classify(level - 1, index * 2 + 1, depth), Ok(parent));
+                }
+            }
+            assert_eq!(classify(depth - 1, 0, depth), Ok(Partition::Left));
+            assert_eq!(classify(depth - 1, 1, depth), Ok(Partition::Right));
+            assert_eq!(classify(depth, 0, depth), Ok(Partition::Root));
+        }
+    }
+
+    #[test]
+    fn malformed_coordinates_and_partition_names_fail_closed() {
+        for (level, index, depth) in [(0, 0, 7), (8, 0, 7), (1, 64, 7), (6, 2, 7),
+            (7, 1, 7), (4, 0, 3), (1, 0, 1), (1, 0, 8)] {
+            assert!(classify(level, index, depth).is_err());
+        }
+        for value in ["", "all", "LEFT", "root/../left"] {
+            assert!(Partition::parse(value).is_err());
+        }
+        for name in ["left", "right", "root"] {
+            assert_eq!(Partition::parse(name).unwrap().name(), name);
+        }
+    }
+}
