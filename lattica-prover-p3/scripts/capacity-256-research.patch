+#![cfg(feature = "block-v2-capacity-256")]
+use lattica_prover_p3::block_v2::{commitment::{self, Context, Entry, Kind}, machine::{programs, typed_pairs}, profile, recursive};
+use p3_field::{PrimeCharacteristicRing, PrimeField64};
+
+#[test]
+fn full_count_survives_statement_and_tree_composition() {
+    assert_eq!((profile::MAX_TRANSACTIONS, commitment::DEPTH), (256, 8));
+    let context = Context { profile_id: profile::CANDIDATE_PROFILE_ID, chain_id: [42; 32] };
+    let entries: Vec<_> = (0..256).map(|i| Entry { kind: Kind::JoinSplit, statement_digest: [i, i + 1, i + 2, i + 3] }).collect();
+    let mut nodes: Vec<_> = entries.iter().map(|entry| commitment::leaf(context, *entry).unwrap()).collect();
+    while nodes.len() > 1 {
+        nodes = nodes.chunks_exact(2).map(|pair| commitment::merge_nodes(pair[0], pair[1]).unwrap()).collect();
+    }
+    let root = nodes[0];
+    assert_eq!(root.count, 256);
+    assert_eq!(root.root, commitment::root(context, &entries).unwrap());
+    let public = programs::statement(root, programs::MERGE);
+    assert_eq!(public[programs::COUNT].as_canonical_u64(), 256);
+    assert_eq!(recursive::summary(&public).unwrap(), root);
+    for invalid in [257, 512, 65536] {
+        let mut forged = public;
+        forged[programs::COUNT] = p3_goldilocks::Goldilocks::from_u64(invalid);
+        assert!(recursive::summary(&forged).is_err());
+    }
+    let mut excessive = entries.clone(); excessive.push(entries[0]);
+    assert!(commitment::root(context, &excessive).is_err());
+}
+
+#[test]
+fn complete_proof_plan_crosses_the_byte_boundary() {
+    for count in [1, 2, 63, 64, 65, 127, 128, 129, 254, 255, 256] {
+        let plan = typed_pairs::proof_plan(count).unwrap();
+        assert!(plan.subtree_level <= commitment::DEPTH);
+    }
+    assert!(typed_pairs::proof_plan(0).is_err());
+    assert!(typed_pairs::proof_plan(257).is_err());
+    let full = typed_pairs::proof_plan(256).unwrap();
+    assert_eq!(full.subtree_level, 8);
+    assert_eq!(full.proposed_proofs, 255);
+}
