+/// Offline full-block measurement only; retains normal owned GPU resource admission.
+/// This harness grants no pool timing approval or production deadline qualification.
+pub(crate) fn benchmark_main() {
+    extern "C" {
+        fn lattica_gpu_public_worker_initialize_from_env() -> i32;
+        fn lattica_gpu_shutdown() -> i32;
+    }
+    let execute = || -> Result<(), Error> {
+        let args: Vec<String> = std::env::args().collect();
+        if profile::MAX_TRANSACTIONS != 256 || !PAIRED {
+            return Err("this measurement harness requires the paired 256 profile".into());
+        }
+        if !matches!(args.get(1).map(String::as_str), Some("register" | "prove-cpu")) {
+            return Err("benchmark harness accepts register or prove-cpu arguments".into());
+        }
+        let budget: u64 = args.last().ok_or("missing worker budget")?.parse()?;
+        if budget != 3 << 30 {
+            return Err("benchmark worker must retain its 3 GiB allowance".into());
+        }
+        require_cpu_limit(budget)?;
+        let start = Instant::now();
+        if unsafe { lattica_gpu_public_worker_initialize_from_env() } != 0 {
+            return Err("bounded GPU benchmark initialization rejected".into());
+        }
+        let initialized = start.elapsed().as_secs_f64();
+        let result = run_inner(&args, true);
+        let shutdown = unsafe { lattica_gpu_shutdown() };
+        result?;
+        if shutdown != 0 { return Err("GPU teardown rejected".into()); }
+        println!("{}", json!({"event":"capacity_benchmark_complete", "block_capacity":256,
+            "gpu_initialization_seconds":initialized, "seconds":start.elapsed().as_secs_f64(),
+            "production_deadline_qualified":false, "worker_memory_bytes":budget}));
+        Ok(())
+    };
+    if let Err(error) = execute() {
+        eprintln!("capacity benchmark failed: {error}");
+        std::process::exit(1);
+    }
+}
