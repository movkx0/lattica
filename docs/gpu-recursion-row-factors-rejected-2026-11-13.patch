+// The table is temporary and charged with both complete transform buffers.
+// Keep the original path for small transforms and for an exact-fit budget;
+// adding this optimization must not invalidate a previously admitted domain.
+fn row_factors_admitted(
+    input: MatrixSpec,
+    log_rows: u32,
+    live: usize,
+    limits: super::super::Limits,
+    max_alloc: usize,
+) -> bool {
+    let Ok((_, width, _)) = geometry(input, log_rows, 1, RowOrder::Natural) else {
+        return false;
+    };
+    width >= 2
+        && input.rows() >= 32
+        && input
+            .rows()
+            .checked_mul(8)
+            .filter(|&bytes| bytes <= (8 << 20) && bytes <= max_alloc)
+            .and_then(|bytes| live.checked_add(bytes))
+            .is_some_and(|live| storage_plan(input, log_rows, live, limits, max_alloc).is_ok())
+}
