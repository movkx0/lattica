+use super::*;
+use p3_field::{Field, PrimeCharacteristicRing, PrimeField64};
+
+#[test]
+fn row_factor_table_respects_exact_memory_and_shape_limits() {
+    let limits = super::super::super::Limits {
+        managed_bytes: 1 << 20,
+        tile_bytes: 1 << 20,
+        staging_bytes: 4096,
+    };
+    let input = MatrixSpec::new(8, 3, Extension::Base, RowOrder::Natural, 11).unwrap();
+    let live = 71 + input.bytes();
+    let baseline = storage_plan(input, 10, live, limits, 1 << 20)
+        .unwrap()
+        .peak_bytes;
+    let required = baseline + input.rows() * 8;
+    assert!(row_factors_admitted(
+        input,
+        10,
+        live,
+        super::super::super::Limits {
+            managed_bytes: required,
+            ..limits
+        },
+        1 << 20
+    ));
+    assert!(!row_factors_admitted(
+        input,
+        10,
+        live,
+        super::super::super::Limits {
+            managed_bytes: required - 1,
+            ..limits
+        },
+        1 << 20
+    ));
+    assert!(storage_plan(
+        input,
+        10,
+        live,
+        super::super::super::Limits {
+            managed_bytes: baseline,
+            ..limits
+        },
+        1 << 20
+    )
+    .is_ok());
+    assert!(!row_factors_admitted(input, 7, live, limits, 1 << 20));
+    assert!(!row_factors_admitted(
+        input,
+        10,
+        usize::MAX,
+        limits,
+        usize::MAX
+    ));
+    for spec in [
+        MatrixSpec::new(8, 1, Extension::Base, RowOrder::Natural, 1).unwrap(),
+        MatrixSpec::new(4, 206, Extension::Base, RowOrder::Natural, 1).unwrap(),
+        MatrixSpec::new(21, 2, Extension::Base, RowOrder::Natural, 1).unwrap(),
+    ] {
+        assert!(!row_factors_admitted(
+            spec,
+            spec.log_rows,
+            0,
+            super::super::super::Limits {
+                managed_bytes: usize::MAX,
+                ..limits
+            },
+            usize::MAX
+        ));
+    }
+    // Extension limbs are independent columns and share the same row factor.
+    let extension = MatrixSpec::new(8, 1, Extension::Cubic, RowOrder::BitReversed, 11).unwrap();
+    assert!(row_factors_admitted(extension, 10, live, limits, 1 << 20));
+}
+
+fn scale(
+    engine: &mut Engine,
+    input: &Allocation,
+    output: &Allocation,
+    parameters: &Allocation,
+    factors: &Allocation,
+    rows: usize,
+    output_rows: usize,
+    width: usize,
+    lookup: bool,
+) -> Result<(u128, u128), String> {
+    let mut factor_ns = 0;
+    if lookup {
+        let mut event = compute::Event::empty();
+        // SAFETY: all extents include guard words and the kernel bounds rows.
+        unsafe {
+            engine
+                .pq
+                .kernel_builder("device_transform_row_factors")
+                .arg(&parameters.buffer)
+                .arg(&factors.buffer)
+                .arg(rows as u32)
+                .global_work_size(rows.div_ceil(256) * 256)
+                .build()
+                .map_err(|e| e.to_string())?
+                .cmd()
+                .enew(&mut event)
+                .enq()
+                .map_err(|e| e.to_string())?;
+        }
+        factor_ns = engine.timeline.record("row_factor_test", &event)?;
+    }
+    let mut event = compute::Event::empty();
+    unsafe {
+        engine
+            .pq
+            .kernel_builder(if lookup {
+                "device_transform_scale_lookup"
+            } else {
+                "device_transform_scale"
+            })
+            .arg(&input.buffer)
+            .arg(&output.buffer)
+            .arg(if lookup {
+                &factors.buffer
+            } else {
+                &parameters.buffer
+            })
+            .arg(width as u32)
+            .arg(rows as u32)
+            .arg(output_rows as u32)
+            .global_work_size((output_rows * width).div_ceil(256) * 256)
+            .build()
+            .map_err(|e| e.to_string())?
+            .cmd()
+            .enew(&mut event)
+            .enq()
+            .map_err(|e| e.to_string())?;
+    }
+    let apply_ns = engine.timeline.record("row_scale_test", &event)?;
+    Ok((factor_ns, apply_ns))
+}
+
+#[test]
+#[ignore = "requires exclusive OpenCL GPU; compares row factors and complete wide outputs"]
+fn gpu_row_factor_lookup_matches_reference_and_wide_legacy_scaling() {
+    use super::super::super::{initialize_mode, Limits, TestShutdownGuard, TransferMode};
+    let _shutdown = TestShutdownGuard;
+    initialize_mode(
+        Limits {
+            managed_bytes: 2 << 30,
+            tile_bytes: 4 << 20,
+            staging_bytes: 64 << 10,
+        },
+        TransferMode::Serial,
+    )
+    .unwrap();
+    let session = DeviceSession::new().unwrap();
+    session.with_engine(|engine| {
+        for (rows, output_rows, width, shift) in [
+            (17usize, 33usize, 3usize, 7u64),
+            (32, 65, 206, GOLDILOCKS_MODULUS - 3),
+            (1 << 17, 1 << 18, 206, 7),
+        ] {
+            let allocate = |words| allocation(&engine.pq, &engine.accounting, engine.limits,
+                engine.max_alloc, words, compute::flags::MEM_READ_WRITE);
+            let input = allocate(rows * width)?;
+            let reference = allocate(output_rows * width + 5)?;
+            let actual = allocate(output_rows * width + 5)?;
+            let parameters = allocate(2)?;
+            let factors = allocate(rows + 5)?;
+            let input_words = (0..rows * width)
+                .map(|i| GOLDILOCKS_MODULUS - 1 - (i as u64 * 71 % 100003)).collect::<Vec<_>>();
+            let mut reference_words = vec![99u64; output_rows * width + 5];
+            let mut actual_words = reference_words.clone();
+            let mut factor_words = vec![99u64; rows + 5];
+            let normalization = Val::from_u64(rows as u64).inverse();
+            let parameter_words = [normalization.as_canonical_u64(), shift];
+            let fence = engine.fence();
+            input.buffer.write(&input_words).enq().map_err(|e| e.to_string())?;
+            reference.buffer.write(&reference_words).enq().map_err(|e| e.to_string())?;
+            actual.buffer.write(&actual_words).enq().map_err(|e| e.to_string())?;
+            factors.buffer.write(&factor_words).enq().map_err(|e| e.to_string())?;
+            parameters.buffer.write(&parameter_words[..]).enq().map_err(|e| e.to_string())?;
+            fence.finish()?;
+            let mut old_times = Vec::new();
+            let mut new_times = Vec::new();
+            for repetition in 0..3 {
+                for lookup in if repetition % 2 == 0 { [false, true] } else { [true, false] } {
+                    let (factor, apply) = scale(engine, &input,
+                        if lookup { &actual } else { &reference }, &parameters, &factors,
+                        rows, output_rows, width, lookup)?;
+                    if lookup { new_times.push(factor + apply); } else { old_times.push(apply); }
+                }
+            }
+            reference.buffer.read(&mut reference_words).enq().map_err(|e| e.to_string())?;
+            actual.buffer.read(&mut actual_words).enq().map_err(|e| e.to_string())?;
+            factors.buffer.read(&mut factor_words).enq().map_err(|e| e.to_string())?;
+            fence.finish()?;
+            assert!(reference_words == actual_words, "scale mismatch rows={rows} width={width}");
+            assert!(actual_words[rows * width..output_rows * width].iter().all(|&x| x == 0));
+            assert_eq!(&actual_words[output_rows * width..], &[99; 5]);
+            assert_eq!(&factor_words[rows..], &[99; 5]);
+            let mut expected = normalization;
+            for (row, factor) in factor_words[..rows].iter().enumerate() {
+                assert_eq!(*factor, expected.as_canonical_u64(), "row={row}");
+                // Independent recurrence and field multiplication check every
+                // column on the irregular-domain boundary cases.
+                if rows <= 32 {
+                    for column in 0..width {
+                        let i = row * width + column;
+                        assert_eq!(actual_words[i],
+                            (Val::from_u64(input_words[i]) * expected).as_canonical_u64());
+                    }
+                }
+                expected *= Val::from_u64(shift);
+            }
+            old_times.sort_unstable();new_times.sort_unstable();
+            eprintln!("GPU_ROW_FACTOR_SCALE rows={rows} output_rows={output_rows} width={width} factor_bytes={} legacy_median_ns={} lookup_median_ns={} verified=true",
+                rows * 8, old_times[1], new_times[1]);
+        }
+        Ok(())
+    }).unwrap();
+}
