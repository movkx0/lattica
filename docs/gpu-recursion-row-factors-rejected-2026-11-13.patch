+// These factors depend only on the public domain, never on trace values.
+// Compute each exponent once instead of repeating it in every matrix column.
+__kernel void device_transform_row_factors(__global const ulong *parameters,
+    __global ulong *factors, uint rows) {
+    size_t row = get_global_id(0);
+    if (row >= rows) return;
+    factors[row] = gl_canon(gl_mul(parameters[0], gl_pow(parameters[1], (ulong)row)));
+}
+__kernel void device_transform_scale_lookup(__global const ulong *coefficients,
+    __global ulong *output, __global const ulong *factors,
+    uint width, uint input_rows, uint output_rows) {
+    size_t i = get_global_id(0);
+    if (i >= (size_t)output_rows * width) return;
+    uint row = (uint)(i / width);
+    output[i] = row < input_rows
+        ? gl_canon(gl_mul(coefficients[i], factors[row])) : 0UL;
