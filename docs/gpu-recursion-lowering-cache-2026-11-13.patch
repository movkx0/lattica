+#[test]
+fn lowering_cache_preserves_fused_reduction_constraints_and_witness_binding() {
+    let (reference, public, witness) = typed_reduction_fixture_with_terms(19);
+    let cache = RecursionLoweringCache::new(1 << 20);
+    let first = cache.prepare(reference.program.clone(), [81; 32]).unwrap();
+    let source = Arc::new((*reference.program).clone());
+    let cached = cache.prepare(source.clone(), [81; 32]).unwrap();
+    assert_eq!(cached.identity(), reference.identity());
+    assert!(cached.matches_program(&source));
+    assert!(Arc::ptr_eq(&first.typed.groups, &cached.typed.groups));
+    assert_eq!(cache.stats().hits, 1);
+    let actual = cached.traces(&public, &witness).unwrap();
+    let expected = reference.traces(&public, &witness).unwrap();
+    for (a, b) in actual.iter().zip(&expected) {
+        assert_eq!(a.width, b.width);
+        assert_eq!(a.values, b.values);
+    }
+    check(&cached, &public, &actual);
+    let mut changed = witness;
+    changed[0] += Val::ONE;
+    assert!(cached.traces(&public, &changed).is_err());
+}
