diff --git a/lattica-prover-p3/src/block_v2/machine/recursion/lowering.rs b/lattica-prover-p3/src/block_v2/machine/recursion/lowering.rs
new file mode 100644
--- /dev/null
+++ b/lattica-prover-p3/src/block_v2/machine/recursion/lowering.rs
@@ -0,0 +1,216 @@
+//! Bounded reuse of immutable lowering metadata, without retaining programs.
+use super::*;
+use std::sync::Mutex;
+
+#[derive(Clone, Copy, Debug, Default, serde::Serialize)]
+pub struct RecursionLoweringCacheStats {
+    pub hits: usize,
+    pub misses: usize,
+    pub oversized: usize,
+    pub retained_bytes: usize,
+    pub peak_bytes: usize,
+    pub reserved_bytes: usize,
+}
+
+struct Plan {
+    id: [u8; 32],
+    rows: [Arc<[u32]>; 3],
+    typed: TypedVerifierPlan,
+    tables: Arc<[layout::TableSpan]>,
+}
+
+impl Plan {
+    fn bytes(template: &RecursionTemplate) -> usize {
+        core::mem::size_of::<Self>()
+            // Ten Arc slice headers, in addition to their payloads.
+            + 20 * core::mem::size_of::<usize>()
+            + template.rows.iter().map(|rows| rows.len() * 4).sum::<usize>()
+            + template.typed.backing_bytes()
+            + core::mem::size_of_val(template.tables.as_ref())
+    }
+
+    fn bind(&self, program: Arc<Program>) -> RecursionTemplate {
+        RecursionTemplate {
+            program,
+            rows: self.rows.clone(),
+            id: self.id,
+            typed: self.typed.clone(),
+            tables: self.tables.clone(),
+        }
+    }
+}
+
+struct State {
+    entry: Option<Plan>,
+    stats: RecursionLoweringCacheStats,
+}
+
+/// One exact public layout, shared by a bounded CPU preparation window.
+/// The caller reserves `limit_bytes` outside the construction job allowance.
+/// Neither source programs, witness values, nor proof randomness are retained.
+pub struct RecursionLoweringCache {
+    state: Mutex<State>,
+}
+
+impl RecursionLoweringCache {
+    pub fn new(limit_bytes: usize) -> Self {
+        Self {
+            state: Mutex::new(State {
+                entry: None,
+                stats: RecursionLoweringCacheStats {
+                    reserved_bytes: limit_bytes,
+                    ..Default::default()
+                },
+            }),
+        }
+    }
+
+    pub fn stats(&self) -> RecursionLoweringCacheStats {
+        self.state.lock().unwrap().stats
+    }
+
+    pub fn prepare(
+        &self,
+        program: Arc<Program>,
+        trusted_registry: [u8; 32],
+    ) -> Result<RecursionTemplate, String> {
+        // This is the same full identity that authenticates GPU preprocessing:
+        // exact instructions, registry, backend version, and security profile.
+        let id = RecursionTemplate::program_identity(&program, trusted_registry)?;
+        {
+            let mut state = self.state.lock().map_err(|_| "lowering cache poisoned")?;
+            if let Some(plan) = state.entry.as_ref().filter(|plan| plan.id == id) {
+                let template = plan.bind(program);
+                state.stats.hits += 1;
+                return Ok(template);
+            }
+            state.stats.misses += 1;
+        }
+        // Independent misses lower concurrently; no compiler runs under the
+        // mutex. A racing replacement is harmless: every hit checks its ID.
+        let template = RecursionTemplate::lower(program, id)?;
+        let bytes = Plan::bytes(&template);
+        let mut state = self.state.lock().map_err(|_| "lowering cache poisoned")?;
+        state.entry = None;
+        state.stats.retained_bytes = 0;
+        if bytes <= state.stats.reserved_bytes {
+            state.entry = Some(Plan {
+                id,
+                rows: template.rows.clone(),
+                typed: template.typed.clone(),
+                tables: template.tables.clone(),
+            });
+            state.stats.retained_bytes = bytes;
+            state.stats.peak_bytes = state.stats.peak_bytes.max(bytes);
+        } else {
+            state.stats.oversized += 1;
+        }
+        Ok(template)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::block_v2::machine::ProgramBuilder;
+
+    fn program(constant: u64) -> Arc<Program> {
+        let mut b = ProgramBuilder::new(1).unwrap();
+        let input = b.input();
+        let c = b.constant(Val::from_u64(constant));
+        let sum = b.add(input, c);
+        let public = b.public(0).unwrap();
+        b.assert_equal(sum, public);
+        Arc::new(b.finish(None).unwrap())
+    }
+
+    #[test]
+    fn lowering_cache_binds_exact_program_registry_and_fresh_source() {
+        let cache = RecursionLoweringCache::new(1 << 20);
+        let original = program(7);
+        let weak = Arc::downgrade(&original);
+        let first = cache.prepare(original.clone(), [42; 32]).unwrap();
+        let other = program(7);
+        let second = cache.prepare(other.clone(), [42; 32]).unwrap();
+        assert_eq!(first.identity(), second.identity());
+        assert!(Arc::ptr_eq(&first.rows[0], &second.rows[0]));
+        assert!(Arc::ptr_eq(
+            &first.typed.references,
+            &second.typed.references
+        ));
+        assert!(second.matches_program(&other));
+        assert!(!second.matches_program(&original));
+        let reference = RecursionTemplate::new(other, [42; 32]).unwrap();
+        for (input, public) in [(3, 10), (11, 18)] {
+            let w = [Val::from_u64(input)];
+            let p = [Val::from_u64(public)];
+            let actual = second.traces(&p, &w).unwrap();
+            let expected = reference.traces(&p, &w).unwrap();
+            assert_eq!(actual.len(), expected.len());
+            for (a, b) in actual.iter().zip(&expected) {
+                assert_eq!(a.width, b.width);
+                assert_eq!(a.values, b.values);
+            }
+        }
+        assert!(second
+            .traces(&[Val::from_u64(10)], &[Val::from_u64(4)])
+            .is_err());
+        drop(first);
+        drop(original);
+        assert!(weak.upgrade().is_none(), "cache retained a source program");
+        assert_eq!(cache.stats().hits, 1);
+        let changed_registry = cache.prepare(program(7), [43; 32]).unwrap();
+        assert_ne!(changed_registry.identity(), second.identity());
+        let changed_op = cache.prepare(program(8), [43; 32]).unwrap();
+        assert_ne!(changed_op.identity(), changed_registry.identity());
+        assert_eq!(cache.stats().hits, 1);
+        assert_eq!(cache.stats().misses, 3);
+    }
+
+    #[test]
+    fn lowering_cache_admits_exact_bytes_and_skips_oversized_metadata() {
+        let source = program(9);
+        let reference = RecursionTemplate::new(source.clone(), [3; 32]).unwrap();
+        let bytes = Plan::bytes(&reference);
+        for (limit, hits) in [(0, 0), (bytes - 1, 0), (bytes, 1)] {
+            let cache = RecursionLoweringCache::new(limit);
+            for _ in 0..2 {
+                assert_eq!(
+                    cache.prepare(source.clone(), [3; 32]).unwrap().identity(),
+                    reference.identity()
+                );
+            }
+            let stats = cache.stats();
+            assert_eq!(stats.hits, hits);
+            assert!(stats.retained_bytes <= limit);
+            assert!(stats.peak_bytes <= limit);
+            assert_eq!(stats.oversized, if hits == 0 { 2 } else { 0 });
+        }
+    }
+
+    #[test]
+    fn lowering_cache_parallel_replacement_keeps_each_program_bound() {
+        let cache = RecursionLoweringCache::new(1 << 20);
+        std::thread::scope(|scope| {
+            for i in 0..8 {
+                let cache = &cache;
+                scope.spawn(move || {
+                    for offset in 0..4 {
+                        let value = i + offset;
+                        let source = program(value);
+                        let template = cache.prepare(source.clone(), [1; 32]).unwrap();
+                        assert!(template.matches_program(&source));
+                        assert_eq!(
+                            template.identity(),
+                            RecursionTemplate::new(source, [1; 32]).unwrap().identity()
+                        );
+                        template
+                            .traces(&[Val::from_u64(value + 3)], &[Val::from_u64(3)])
+                            .unwrap();
+                    }
+                });
+            }
+        });
+        assert!(cache.stats().peak_bytes <= cache.stats().reserved_bytes);
+    }
+}
