  "implemented": [
    "GPU-generated base-field matrices retain shared scrub-on-drop storage across private aliases",
    "Natural-order device evaluations feed inverse NTT, GPU normalization and coset scaling, forward LDE, retained prefixes and Merkle commitments",
    "GPU salt column bands feed trace/lookup/quotient and randomization commitments without salt sample upload or full readback",
    "Private device-only PCS and cubic binary FRI retain device salts and gather only final queried salt rows",
    "Host-salt PCS and existing complete-proof paths remain supported without changing production randomness selection"
  ],
  "validation": {
    "evaluations": "CPU equality for all retained prefix words, caps and queried values/salts/paths across heights 2/32/256/4096, widths 1/3/7/33/35/65, multiple matrices, shifts 1/7/11/p-1 and column/row tiling",
    "shared_streams": "Base/cubic traces at heights 1/8/256/8192 alternate shared GPU stream handles with two randomization polynomials; exact CPU commitment and query equality after successive draws",
    "quotient": "2/4/16 chunks, non-unit cosets and successive random/mask/salt draws match CPU prefixes, caps and queries",
    "fri": "Binary cubic layers at vector heights 2/8/256/8192 match CPU caps, queried values, salts and paths and verify with the CPU extension MMCS",
    "ownership": "An alias remains readable after original handle drop; public promotion rejects; final alias drop scrubs the raw test buffer and restores managed private allocation baseline",
    "admission": "Unsupported random/evaluation geometry, wrong salt counts/height/width/order/shift/session, changed blowup, missing device-only mode, insufficient query-host/device budgets and private salts for public preprocessing reject",
    "transfers": "Evaluation commitment uploads only the existing public NTT root tables (16 times log2 committed height bytes), with no private sample upload or host LDE output; generation downloads only status; final PCS salt gather bytes equal query count times matrix count times four fields",
    "regressions": "Host-salt queries, FRI, full/compact registered proofs, device witness reuse, reference random streams and debug CPU audits pass"
  },
