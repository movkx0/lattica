@@ -0,0 +1,53 @@
+// Keep rate-word accesses constant so the compiler can scalarize the sponge.
+// A matrix/tile boundary never finalizes the padding-free column stream.
+inline void commitment_absorb_blocks(ulong *s, __global const ulong *input,
+    uint width, uint at, __global const ulong *rci, __global const ulong *rcp,
+    __global const ulong *rcf, __global const ulong *diag) {
+    uint col = 0;
+    if (at != 0) {
+        if (at == 1 && col < width) { s[1] = input[col++]; at = 2; }
+        if (at == 2 && col < width) { s[2] = input[col++]; at = 3; }
+        if (at == 3 && col < width) {
+            s[3] = input[col++]; at = 0;
+            perm8(s, rci, rcp, rcf, diag);
+        }
+        if (at != 0) return;
+    }
+    while (width - col >= 4) {
+        s[0] = input[col];
+        s[1] = input[col + 1];
+        s[2] = input[col + 2];
+        s[3] = input[col + 3];
+        perm8(s, rci, rcp, rcf, diag);
+        col += 4;
+    }
+    if (col < width) s[0] = input[col++];
+    if (col < width) s[1] = input[col++];
+    if (col < width) s[2] = input[col];
+}
+
+__kernel void leaf_hash_registers(__global const ulong *input, __global ulong *out,
+    uint row0, uint rows, uint width, __global const ulong *rci,
+    __global const ulong *rcp, __global const ulong *rcf, __global const ulong *diag) {
+    size_t row = get_global_id(0);
+    if (row >= rows) return;
+    ulong s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    commitment_absorb_blocks(s, input + row * (size_t)width, width, 0,
+        rci, rcp, rcf, diag);
+    if (width & 3u) perm8(s, rci, rcp, rcf, diag);
+    for (uint k = 0; k < 4; ++k) out[((size_t)row0 + row) * 4 + k] = gl_canon(s[k]);
+}
+
+__kernel void lde_absorb_registers(__global const ulong *input, __global ulong *states,
+    uint row0, uint rows, uint width, uint rate_offset,
+    __global const ulong *rci, __global const ulong *rcp,
+    __global const ulong *rcf, __global const ulong *diag) {
+    size_t row = get_global_id(0);
+    if (row >= rows) return;
+    size_t base = ((size_t)row0 + row) * 8;
+    ulong s[8];
+    for (uint k = 0; k < 8; ++k) s[k] = states[base + k];
+    commitment_absorb_blocks(s, input + row * (size_t)width, width, rate_offset,
+        rci, rcp, rcf, diag);
+    for (uint k = 0; k < 8; ++k) states[base + k] = s[k];
+}
